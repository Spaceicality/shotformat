{
	"schemaVersion": 1,
	"id": "shotformat",
	"version": "${version}",
	"name": "ShotFormat",
	"description": "Simple mod that allows changing the file format of screenshots",
	"authors": [
		"Spaceicality"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/shotformat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.nolananderson.ShotFormat"
		],
		"client": [
			"dev.nolananderson.client.ShotFormatClient"
		],
		"modmenu": [
			"dev.nolananderson.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"shotformat.mixins.json",
		{
			"config": "shotformat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": ">=26.1.154"
	},
	"suggests": {
		"modmenu": "*"
	}
}